# Release candidate only. Never copy the development .env or commit real credentials.
# Confirm server inventory and topology before applying this Compose on Tencent Cloud.
IMAGE_TAG=
WEB_PORT=
CREATOR_PUBLIC_BASE_URL=
SESSION_COOKIE_SECURE=true
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
# Independent random 32-byte key, base64 encoded; preserve it when recovering encrypted credentials.
NOTIFICATION_ENCRYPTION_KEY=

# Optional provider keys stay empty for local packaging checks; both schedulers are disabled.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
MCP_SEARCH_URL=
MCP_SEARCH_BEARER_TOKEN=
# Budget guard is enabled. Without verified prices, paid operations are refused.
MODEL_INPUT_CNY_PER_MILLION=
MODEL_OUTPUT_CNY_PER_MILLION=
MCP_SEARCH_CNY_PER_CALL=
USER_MONTHLY_CALL_LIMIT=100
SYSTEM_MONTHLY_BUDGET_CNY=100
