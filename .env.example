# Copy to .env for local configuration. Never commit real secrets.
# Compose reads .env; scripts/start-backend.ps1 imports it for Spring Boot.
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
REDIS_PASSWORD=
SPRING_PROFILES_ACTIVE=dev
DEV_USER_PASSWORD=
# Development-only registration code; generated by scripts/init-dev.ps1 for new local environments.
DEV_INVITE_CODE=
# Set true behind HTTPS in production; do not enable the dev profile there.
SESSION_COOKIE_SECURE=false
# Optional overrides: DB_URL, DB_USER, REDIS_HOST, REDIS_PORT.

# Leave empty to keep the model gateway disabled; every call then fails as MODEL_NOT_CONFIGURED.
# A real key enables paid DeepSeek calls from the backend only.
DEEPSEEK_API_KEY=
# Optional overrides: DEEPSEEK_BASE_URL, DEEPSEEK_MODEL, DEEPSEEK_TIMEOUT.

# Optional Streamable HTTP MCP search service. Keep empty until a reviewed service is selected.
# Only names in MCP_SEARCH_ALLOWED_TOOLS are visible to the model; credentials stay on the backend.
MCP_SEARCH_URL=
MCP_SEARCH_BEARER_TOKEN=
MCP_SEARCH_ALLOWED_TOOLS=search
MCP_SEARCH_TIMEOUT=10s
